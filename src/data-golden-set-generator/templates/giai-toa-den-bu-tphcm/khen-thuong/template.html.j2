{% extends "_shared/base.html.j2" %}
{#- Quyết định thưởng bàn giao mặt bằng: văn bản hành chính A4 dọc, in máy. -#}
{% block head %}{% include "giai-toa-den-bu-tphcm/_bt.css.j2" %}{% endblock %}
{% block body %}
<section {{ page_attrs() }}>
  <div class="hdr">
    <div class="hdr-left">
      <div class="bold">ỦY BAN NHÂN DÂN</div>
      <div class="bold">{{ field("co_quan", "plain") }}</div>
      <div style="margin-top: 2mm;">Số: {{ field("so_qd", "plain") }}</div>
    </div>
    <div>
      {{ quoc_hieu() }}
      <div class="right italic">{{ field("ngay_qd", "plain") }}</div>
    </div>
  </div>

  <div class="title" style="margin-top: 8mm; margin-bottom: 1mm;">QUYẾT ĐỊNH</div>
  <div class="center bold">Về việc thưởng cho hộ gia đình bàn giao mặt bằng đúng thời hạn</div>
  <div class="center">Dự án: {{ field("ten_du_an", "plain") }}</div>
  <div class="center" style="margin: 4mm 0;">ỦY BAN NHÂN DÂN</div>

  <div class="dieu italic">Căn cứ Quyết định số {{ field("so_qd_thu_hoi", "plain") }} ngày {{ field("ngay_qd_thu_hoi", "plain") }}
    của Ủy ban nhân dân về việc thu hồi đất và phê duyệt phương án bồi thường, hỗ trợ, tái định cư;</div>
  <div class="dieu italic">Căn cứ thông báo thời hạn bàn giao mặt bằng chậm nhất ngày {{ field("han_ban_giao", "plain") }};</div>
  <div class="dieu italic">Căn cứ biên bản bàn giao mặt bằng ngày {{ field("ngay_ban_giao", "plain") }};</div>

  <div class="center bold" style="margin: 4mm 0;">QUYẾT ĐỊNH:</div>
  <div class="dieu"><b>Điều 1.</b> Thưởng cho {{ field("nguoi_duoc_thuong", "plain bold") }}, đại diện {{ field("dai_dien_cho", "plain") }},
    có đất bị thu hồi tại {{ field("dia_chi_thua_dat", "plain") }}
    ({{ field("pham_vi", "plain") }}, diện tích {{ field("dien_tich_thu_hoi", "plain") }}),
    đã bàn giao mặt bằng đúng thời hạn.</div>
  <div class="dieu">Số tiền thưởng: {{ field("so_tien", "plain bold") }}</div>
  <div class="dieu">(Bằng chữ: {{ field("so_tien_bang_chu", "plain italic") }}).</div>
  <div class="dieu"><b>Điều 2.</b> Đơn vị làm nhiệm vụ bồi thường, giải phóng mặt bằng chi trả tiền thưởng cho hộ gia đình.</div>
  <div class="dieu"><b>Điều 3.</b> Quyết định này có hiệu lực kể từ ngày ký.</div>

  <div class="sign">
    <div class="bold">TM. ỦY BAN NHÂN DÂN</div>
    <div class="bold">{{ field("chuc_vu_ky", "plain") }}</div>
    {{ signature(doc.doc_id ~ "ky", 150, 55) }}
    <div class="bold">{{ field("nguoi_ky", "plain") }}</div>
    {{ stamp_at("ky", "-6mm", "8mm", 125) }}
  </div>
</section>
{% endblock %}
