{% extends "_shared/base.html.j2" %}
{#- Bảng chiết tính bồi thường nhà, công trình, vật kiến trúc: A4 ngang, bảng 10 cột. -#}
{% block head %}{% include "giai-toa-den-bu-tphcm/_bt.css.j2" %}{% endblock %}
{% block body %}
<section {{ page_attrs() }}>
  <div class="hdr">
    <div class="hdr-left">
      <div class="bold">ỦY BAN NHÂN DÂN</div>
      <div class="bold">{{ field("co_quan", "plain") }}</div>
    </div>
    {{ quoc_hieu() }}
  </div>
  <div class="title">BẢNG CHIẾT TÍNH BỒI THƯỜNG NHÀ, CÔNG TRÌNH, VẬT KIẾN TRÚC</div>
  <div class="center italic">(Kèm theo Quyết định số {{ field("so_qd", "plain") }} ngày {{ field("ngay_qd", "plain") }} của Ủy ban nhân dân)</div>
  <div class="center">Dự án: {{ field("ten_du_an", "plain bold") }}</div>

  <div class="info">
    <div>Chủ sở hữu: {{ field("chu_su_dung", "plain bold") }}</div>
    <div>Người nhận: {{ field("nguoi_nhan", "plain") }}</div>
    <div class="wide">Địa chỉ: {{ field("dia_chi_thua_dat", "plain") }}</div>
    <div>Số tầng: {{ field("so_tang", "plain") }} &nbsp; Diện tích sàn: {{ field("dien_tich_san", "plain") }} &nbsp; Năm xây dựng: {{ field("nam_xay_dung", "plain") }}</div>
    <div>{{ field("pham_vi", "plain") }}</div>
  </div>

  <table class="grid calc">
    <thead><tr><th style="width: 7mm;">STT</th><th>Hạng mục</th><th>Kết cấu</th><th>ĐVT</th><th>Khối lượng</th>
      <th>Đơn giá xây mới (đ)</th><th>Tỷ lệ còn lại</th><th>Giá trị hiện có (đ)</th><th>Bổ sung đủ 60% (đ)</th><th>Thành tiền (đ)</th></tr></thead>
    <tbody>
    {%- for i in range(1, doc.groups.ct + 1) %}{% set p = "ct%d_" % i %}
    <tr><td class="center">{{ i }}</td><td>{{ field(p ~ "hang_muc", "plain") }}</td><td>{{ field(p ~ "ket_cau", "plain small") }}</td>
      <td class="center">{{ field(p ~ "don_vi", "plain") }}</td><td class="num">{{ field(p ~ "khoi_luong", "plain") }}</td>
      <td class="num">{{ field(p ~ "don_gia", "plain") }}</td><td class="num">{{ field(p ~ "ty_le", "plain") }}</td>
      <td class="num">{{ field(p ~ "gia_tri_hien_co", "plain") }}</td><td class="num">{{ field(p ~ "bo_sung", "plain") }}</td>
      <td class="num">{{ field(p ~ "thanh_tien", "plain") }}</td></tr>
    {%- endfor %}
    <tr class="total"><td></td><td colspan="8">TỔNG CỘNG</td><td class="num">{{ field("tong_cong", "plain") }}</td></tr>
    </tbody>
  </table>
  <div class="row">Bằng chữ: {{ field("tong_bang_chu", "plain italic") }}</div>

  <div class="signs">
    <div class="sign-block"><div class="bold">NGƯỜI LẬP</div>{{ signature(doc.doc_id ~ "lap", 110, 40) }}<div>{{ field("nguoi_lap", "plain") }}</div></div>
    <div class="sign-block"><div class="bold">NGƯỜI KIỂM TRA</div>{{ signature(doc.doc_id ~ "kt", 110, 40) }}<div>{{ field("nguoi_kiem_tra", "plain") }}</div></div>
    <div class="sign-block approver">
      <div class="italic">{{ field("ngay_lap", "plain") }}</div>
      <div class="bold">{{ field("chuc_vu_duyet", "plain") }}</div>
      {{ signature(doc.doc_id ~ "duyet", 130, 45) }}
      <div class="bold">{{ field("nguoi_duyet", "plain") }}</div>
      {{ stamp_at("duyet", "-4mm", "4mm", 110) }}
    </div>
  </div>
</section>
{% endblock %}
