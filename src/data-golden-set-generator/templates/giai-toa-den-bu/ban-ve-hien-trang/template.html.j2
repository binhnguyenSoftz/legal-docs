{% extends "_shared/base.html.j2" %}
{#- Bản vẽ kỹ thuật: chữ nằm rải rác trong hình vẽ, ít văn bản liền mạch. -#}
{% block head %}
<style>
.page { padding: 10mm 10mm 10mm 15mm; font-size: 10pt; line-height: 1.3; }
.sheet { position: absolute; inset: 10mm 10mm 10mm 15mm; border: 1.5px solid currentColor; }
.head { position: absolute; left: 4mm; right: 4mm; top: 4mm; text-align: center; }
.head .t { font-weight: bold; font-size: 15pt; letter-spacing: 0.3mm; }
.draw { position: absolute; left: 4mm; top: 30mm; width: 120mm; height: 170mm; border: 0.5px solid #999; }
.side { position: absolute; right: 4mm; top: 30mm; width: 55mm; }
.side table.grid td { font-size: 9pt; }
.titleblock { position: absolute; left: 0; right: 0; bottom: 0; height: 58mm; border-top: 1.5px solid currentColor; }
.titleblock table { width: 100%; height: 100%; border-collapse: collapse; }
.titleblock td { border: 1px solid currentColor; padding: 1.5mm 2mm; vertical-align: top; font-size: 9pt; }
.sig { position: relative; height: 16mm; }
</style>
{% endblock %}
{% block body %}
<section {{ page_attrs() }}>
  <div class="sheet">
    <div class="head">
      <div class="t">BẢN VẼ HIỆN TRẠNG NHÀ Ở, ĐẤT Ở</div>
      <div>Địa chỉ: {{ field("dia_chi", "plain") }}</div>
      <div>Thửa đất số: {{ field("so_thua", "plain bold") }} &nbsp;&nbsp; Tờ bản đồ số: {{ field("to_ban_do", "plain bold") }}
        &nbsp;&nbsp; Tỷ lệ: {{ field("ty_le", "plain") }}</div>
    </div>
    <div class="draw">
      {{ parcel(property.polygon, 453, 642, ["canh_1", "canh_2", "canh_3", "canh_4"], ["giap_1", "giap_2", "giap_3", "giap_4"],
                north=property.goc_bac, house=property.nha.ty_le, size=11, margin=95) }}
    </div>
    <div class="side">
      <div class="bold center" style="margin-bottom: 2mm;">BẢNG THỐNG KÊ DIỆN TÍCH</div>
      <table class="grid">
        <tr><td>Diện tích khuôn viên</td><td>{{ field("dien_tich", "plain") }}</td></tr>
        <tr><td>Diện tích xây dựng</td><td>{{ field("dien_tich_xay_dung", "plain") }}</td></tr>
        <tr><td>Tổng diện tích sàn</td><td>{{ field("dien_tich_san", "plain") }}</td></tr>
        <tr><td>Số tầng</td><td>{{ field("so_tang", "plain") }}</td></tr>
        <tr><td>Kết cấu</td><td>{{ field("ket_cau", "plain") }}</td></tr>
      </table>
      <div class="small" style="margin-top: 4mm;">Ghi chú:<br>- Phần gạch chéo: diện tích xây dựng.<br>- Kích thước ghi bằng mét.<br>- Tọa độ, kích thước theo hiện trạng thực tế tại thời điểm đo vẽ.</div>
    </div>
    <div class="titleblock">
      <table>
        <tr>
          <td colspan="2" class="center bold">{{ field("don_vi_do_ve", "plain") }}</td>
          <td rowspan="3" style="width: 55mm; position: relative;" class="center">
            Chủ sử dụng<br><span class="small italic">(Ký, ghi rõ họ tên)</span>
            <div class="sig">{{ signature(doc.doc_id ~ "chu", 110, 45) }}</div>
            {{ field("chu_su_dung", "plain bold") }}
          </td>
        </tr>
        <tr>
          <td style="position: relative;">Người đo vẽ<div class="sig">{{ signature(doc.doc_id ~ "do", 100, 40) }}</div>{{ field("nguoi_do_ve", "plain") }}</td>
          <td style="position: relative;">Người kiểm tra<div class="sig">{{ signature(doc.doc_id ~ "kt", 100, 40) }}</div>{{ field("nguoi_kiem_tra", "plain") }}
            <div class="stamp-wrap" style="left: 18mm; top: 2mm;">{{ stamp(doc.doc_id ~ "dv", 105) }}</div></td>
        </tr>
        <tr><td colspan="2">Ngày đo vẽ: {{ field("ngay_do_ve", "plain") }}</td></tr>
      </table>
    </div>
  </div>
</section>
{% endblock %}
